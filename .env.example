# ─────────────────────────────────────────────────────────────
# RetailCRM MG Connector — пример конфигурации
# Скопируйте в ~/.retailcrm-mg/.env и заполните.
# Файл содержит секреты: chmod 600, никогда не коммитить.
# ─────────────────────────────────────────────────────────────

# Адрес вашего аккаунта RetailCRM — тот, по которому вы заходите в CRM.
# Значения по умолчанию нет: у каждого аккаунта адрес свой.
RETAILCRM_BASE_URL=

# API-ключ RetailCRM. Нужен ТОЛЬКО для `retailcrm-mg bootstrap`.
# Права: чтение и запись integration modules.
# После выпуска mgBot-токена ключ можно убрать из .env.
RETAILCRM_API_KEY=

# База MessageGateway Bot API вашего аккаунта.
# Заполняется автоматически при bootstrap, если RetailCRM вернул адрес.
# Иначе укажите вручную, напр. https://mg.example.com/api/bot/v1
RETAILCRM_MG_API_BASE=

# Идентификаторы integration module. Заполняются автоматически при bootstrap.
# По умолчанию: mg_connector_<hostname>.
RETAILCRM_MG_MODULE_CODE=
RETAILCRM_MG_MODULE_NAME=
RETAILCRM_MG_CLIENT_ID=

# Токен бота MessageGateway. Выпускается RetailCRM при bootstrap,
# передаётся в заголовке X-Bot-Token. Не переносите его с другого сервера.
RETAILCRM_MG_BOT_TOKEN=

# Таймаут HTTP-запросов, секунды.
RETAILCRM_MG_TIMEOUT=30
